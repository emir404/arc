# Notion — required for the /careers application form
# Internal integration secret from https://www.notion.so/my-integrations
NOTION_TOKEN=
# Target database that receives applications (printed by scripts/setup-notion.ts)
NOTION_DATABASE_ID=

# Setup script only — parent page the database is created under.
# Share the page with your integration first. Not needed at runtime.
NOTION_PARENT_PAGE_ID=

# Optional — application notification emails via Resend (https://resend.com).
# If unset, notifications are skipped silently.
RESEND_API_KEY=
# Optional overrides for the notification sender/recipient.
# CAREERS_NOTIFY_TO=emir@witharc.co
# CAREERS_NOTIFY_FROM=careers@witharc.co
