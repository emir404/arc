# Copy to .env.local and fill in. All keys live in the Supabase and Resend dashboards.

# Supabase — careers data (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…
SUPABASE_SECRET_KEY=sb_secret_…

# Admin panel (/admin) — generate with: openssl rand -base64 24
ADMIN_PASSWORD=…

# Resend — application notification emails (resend.com/api-keys)
RESEND_API_KEY=re_…
CAREERS_NOTIFY_EMAIL=you@witharc.co
CAREERS_FROM_EMAIL=Arc Careers <careers@witharc.co>
