---
import { CAL_URL, CONTACT_EMAIL } from "../data/site";

interface Props {
  /** The button's words. */
  book?: string;
  /** The email link's words. */
  email?: string;
  /** A small line under the two, such as what the call is. */
  note?: string;
}

const { book = "Book a call", email = "Send message", note } = Astro.props;
---

<div class="cta">
  <div class="actions">
    <a class="button" href={CAL_URL} target="_blank">{book}</a>
    <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{email}</a>
  </div>
  {note && <p class="cta__note">{note}</p>}
</div>
