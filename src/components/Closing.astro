---
import Actions from "./Actions.astro";

interface Props {
  /** The headline above the buttons. The YC page has its own. */
  heading?: string;
}

const { heading = "Look like the company you’re about to be." } = Astro.props;
---

<section class="col closing" id="contact">
  <h2 class="closing__statement">{heading}</h2>
  <Actions />
</section>
