---
import Actions from "./Actions.astro";

interface Props {
  /** The headline above the buttons. The YC, speedrun and launch pages have their own. */
  heading?: string;
}

const { heading = "Your launch should look as good as your product works." } = Astro.props;
---

<section class="col closing" id="contact">
  <h2 class="closing__statement">{heading}</h2>
  <Actions />
</section>
