---
import type { ImageMetadata } from "astro";
import { Font, getImage } from "astro:assets";
import studioOg from "../assets/og.png";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** The link preview image and its alt text, for a page that has its own. Other pages share the studio's. */
  og?: { image: ImageMetadata; alt: string };
  /** Asks search engines to leave the page out of their results, for a page that isn't ready to be found. */
  noindex?: boolean;
  /** The page opens with the large lead text, so its typeface, Funnel Display, is preloaded with the page. */
  lead?: boolean;
}

const {
  title,
  description,
  og = {
    image: studioOg,
    alt: "Arc Studio. All-in-one design studio. Direction, product thinking, design, development and motion in one place.",
  },
  noindex = false,
  lead = false,
} = Astro.props;

// The page's address without its query, such as the "?from=yc" on project pages, so search engines count every variant as one page.
const canonical = new URL(Astro.url.pathname, Astro.site);

// Link preview images are exported at 4x and scaled to 2x here, since X rejects images wider than 4096px.
// Setting a quality saves a 256-colour palette PNG, which halves the file without visible change to flat artwork like these.
// The build gives the file a hashed name, so sites that cache previews by image URL pick up a new version.
const ogImage = await getImage({ src: og.image, width: 2400, format: "png", quality: 100 });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The page colour (--page in global.css), for browsers that tint their bars to match the page. -->
    <meta name="theme-color" content="#f2efe8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arc Studio" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta property="og:image:width" content={ogImage.attributes.width} />
    <meta property="og:image:height" content={ogImage.attributes.height} />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@arcstudio" />
    <meta name="twitter:image:alt" content={og.alt} />
    <!-- The SVG follows the browser's light or dark theme; browsers without SVG icons use the .ico. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!--
      The typefaces, served from this site (see astro.config.mjs). Preloading starts the download with the page
      instead of after the stylesheets, so the text is drawn once, in its own typeface. Only the Latin files are
      preloaded; the rest download if a page needs them. The handwriting on the main page appears after a delay,
      which leaves Caveat time to arrive without one.
    -->
    <Font cssVariable="--font-funnel-sans" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-funnel-display" preload={lead && [{ subset: "latin" }]} />
    <Font cssVariable="--font-caveat" />
    <!-- Whatever a page adds to the head, such as the main page's structured data. -->
    <slot name="head" />
  </head>
  <body>
    <slot />

    <script>
      import "../scripts/sounds.js";
      import "../scripts/main.js";

      // The Agentation feedback toolbar, in development only: production builds leave it out entirely.
      if (import.meta.env.DEV) import("../scripts/agentation.js");
    </script>
  </body>
</html>
