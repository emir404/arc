---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import Logo from "../components/Logo.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Page not found · Arc Studio" description="There is no page at this address." noindex>
  <Sidebar back={{ href: "/", label: "Arc Studio" }} />

  <main>
    <header class="col intro" id="top">
      <Logo href="/" label="Arc, back to the main page" />

      <div class="intro__text">
        <div>
          <h1 class="intro__name">Page not found</h1>
          <p class="muted">There is no page at this address.</p>
        </div>
      </div>
    </header>

    <Footer />
  </main>
</Layout>
