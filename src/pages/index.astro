---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import Logo from "../components/Logo.astro";
import WorksStrip from "../components/WorksStrip.astro";
import Testimonials from "../components/Testimonials.astro";
import Pricing from "../components/Pricing.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
import Faq from "../components/Faq.astro";
import { testimonials } from "../data/testimonials";
import { works, clients, clientName, hasPage, selectedWorks } from "../data/works";
import { CONTACT_EMAIL, socials } from "../data/site";
import { buildCalUrl, pageName } from "../data/booking";
import { capacity } from "../data/plans";
import logo from "../assets/logo.svg";

// The headline and the line under it.
const hero = {
  title: "Launch in a month.",
  sub: "We design and build for AI startups: your brand, site, product, and launch video.",
};

// What search engines and link previews show for the page.
const description = "Arc designs and builds brands, sites, product, and launch videos for AI startups. One month per launch.";

// Structured data saying which Arc Studio this is. Screenwriting software, an audio product and others share the name,
// so the founder, country and accounts here help search engines and AI assistants tell the design studio apart.
// The founder and country are as the Privacy Policy and Terms of Service state them.
const organization = new URL("/#organization", Astro.site).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organization,
      name: "Arc Studio",
      alternateName: "Arc",
      url: new URL("/", Astro.site).href,
      logo: new URL(logo.src, Astro.site).href,
      description: `Arc Studio is the design and build team for AI startups: brand, product, site, and launch video, from one team in one month. Worked with 10+ Y Combinator companies.`,
      email: CONTACT_EMAIL,
      founder: { "@type": "Person", name: "Emir Ayaz" },
      address: { "@type": "PostalAddress", addressCountry: "TR" },
      sameAs: socials.map((social) => social.url),
    },
    {
      "@type": "WebSite",
      name: "Arc Studio",
      alternateName: "Arc",
      url: new URL("/", Astro.site).href,
      publisher: { "@id": organization },
    },
  ],
};
---

<Layout title="Arc: design and build team for AI startups" description={description} lead>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
  <Sidebar
    sections={[
      { id: "top", label: "Arc Studio", logo: true },
      { id: "works", label: "Works" },
      { id: "testimonials", label: "Testimonials" },
      { id: "pricing", label: "Pricing" },
      { id: "faq", label: "FAQ" },
      { id: "contact", label: "Contact" },
    ]}
    pages={[{ href: "/launch/", label: "Launch package" }]}
  />

  <main>
    <header class="col intro intro--lead" id="top">
      <Logo href="#top" label="Arc" />

      <div class="lead">
        <h1><span class="hl">{hero.title}</span></h1>
        <p>{hero.sub}</p>
        <!-- The list stays on one line: a line break inside it would put a space before each comma. -->
        <p>
          Trusted by teams at {clients.map((key, i) => <>{i > 0 && ", "}{hasPage(works[key]) ? <a class="lead__link" href={`/work/${key}/`} target="_blank">{clientName(works[key])}</a> : <span class="lead__name">{clientName(works[key])}</span>}</>)} <span class="nowrap">&amp; more</span>
        </p>
        <!--
          The pages for YC and a16z speedrun founders, with their prices. The second link keeps the classes of the
          handwritten note that hung from it, so the lines break as they did: on phones the link has a line of its own.
        -->
        <p>
          In YC? <a class="lead__link nowrap" href="/yc/" target="_blank">See your pricing&nbsp;→</a><br />
          In a16z&nbsp;speedrun? <br class="note__break" /><a class="lead__link note__link" href="/speedrun/" target="_blank">See your pricing&nbsp;→</a>
        </p>
        <div class="cta">
          <div class="actions">
            <a class="button" href={buildCalUrl(pageName(Astro.url.pathname))} target="_blank" data-book="hero">Book a call</a>
            <a class="text-link" href="/launch/" target="_blank" data-event="see_launch_clicked" data-location="hero">See Launch&nbsp;→</a>
          </div>
          <p class="cta__note">{capacity}</p>
        </div>
      </div>
    </header>

    <WorksStrip works={selectedWorks} start="spacefast" label="Selected works" />

    <Testimonials heading="Testimonials" quotes={["vercel", "sim", "agentmail", "feyn", "orchid"]} />

    <Pricing />

    <figure class="col pullquote">
      <blockquote>
        <p set:html={testimonials.agentphone.text} />
      </blockquote>
      <figcaption>Meet Modi, AgentPhone (YC P26)</figcaption>
    </figure>

    <Faq structuredData />

    <Closing />

    <Footer />
  </main>
</Layout>
