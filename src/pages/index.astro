---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import Logo from "../components/Logo.astro";
import WorksStrip from "../components/WorksStrip.astro";
import Testimonials from "../components/Testimonials.astro";
import Pricing from "../components/Pricing.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
import Faq from "../components/Faq.astro";
import { testimonials } from "../data/testimonials";
import { works, clients, clientName, hasPage, selectedWorks } from "../data/works";
import { CONTACT_EMAIL, socials } from "../data/site";
import { buildCalUrl, pageName } from "../data/booking";
import logo from "../assets/logo.svg";

/*
  The headline and the line under it. Two others were written with them, for Emir to choose between:
    B. "Your brand, product, site, and launch video. One team."
       "We get freshly funded AI startups launch-ready in a month, then stay on as your design team."
    C. "The design team AI startups launch with."
       "Brand, site, product, and video for YC and speedrun founders. One month to launch."
*/
const hero = {
  title: "Launch-ready in one month.",
  sub: "Arc is the design and build team for AI startups. Brand, product, site, and launch video. One team, one month.",
};

// What search engines and AI assistants show for the studio: the category and who it's for, which the page itself leaves to the design.
const description =
  "Arc Studio is the all-in-one design studio for early-stage startups. Direction, product thinking, design, development and motion in one place. Worked with 10+ Y Combinator companies.";

// Structured data saying which Arc Studio this is. Screenwriting software, an audio product and others share the name,
// so the founder, country and accounts here help search engines and AI assistants tell the design studio apart.
// The founder and country are as the Privacy Policy and Terms of Service state them.
const organization = new URL("/#organization", Astro.site).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organization,
      name: "Arc Studio",
      alternateName: "Arc",
      url: new URL("/", Astro.site).href,
      logo: new URL(logo.src, Astro.site).href,
      description,
      email: CONTACT_EMAIL,
      founder: { "@type": "Person", name: "Emir Ayaz" },
      address: { "@type": "PostalAddress", addressCountry: "TR" },
      sameAs: socials.map((social) => social.url),
    },
    {
      "@type": "WebSite",
      name: "Arc Studio",
      alternateName: "Arc",
      url: new URL("/", Astro.site).href,
      publisher: { "@id": organization },
    },
  ],
};
---

<Layout title="Arc Studio · All-in-one design studio for early-stage startups" description={description} lead>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
  <Sidebar
    sections={[
      { id: "top", label: "Arc Studio", logo: true },
      { id: "works", label: "Works" },
      { id: "testimonials", label: "Testimonials" },
      { id: "pricing", label: "Pricing" },
      { id: "faq", label: "FAQ" },
      { id: "contact", label: "Contact" },
    ]}
    pages={[{ href: "/launch/", label: "Launch package" }]}
  />

  <main>
    <header class="col intro intro--lead" id="top">
      <Logo href="#top" label="Arc" />

      <div class="lead">
        <h1><span class="hl">{hero.title}</span></h1>
        <p>{hero.sub}</p>
        <div class="cta">
          <div class="actions">
            <a class="button" href={buildCalUrl(pageName(Astro.url.pathname))} target="_blank" data-book="hero">Book a call</a>
            <a class="text-link" href="/launch/" target="_blank" data-event="see_launch_clicked" data-location="hero">See Launch&nbsp;→</a>
          </div>
        </div>
        <!-- The list stays on one line: a line break inside it would put a space before each comma. -->
        <p>
          Trusted by teams at {clients.map((key, i) => <>{i > 0 && ", "}{hasPage(works[key]) ? <a class="lead__link" href={`/work/${key}/`} target="_blank">{clientName(works[key])}</a> : <span class="lead__name">{clientName(works[key])}</span>}</>)} <span class="nowrap">&amp; more</span>
        </p>
        <!--
          The pages for YC and a16z speedrun founders, with their prices. A handwritten note hangs under the second
          link, in the blank line below: the arrow draws itself (shaft, then head), then the words appear.
        -->
        <p>
          In YC? <a class="lead__link nowrap" href="/yc/" target="_blank">See your pricing&nbsp;→</a><br />
          In a16z&nbsp;speedrun? <br class="note__break" /><a class="lead__link note__link" href="/speedrun/" target="_blank">See your pricing&nbsp;→<span class="note" aria-hidden="true">
              <svg class="note__arrow" viewBox="0 0 44 36" fill="none">
                <path class="note__arrow-shaft" pathLength="1" d="M41 5.5C31.5 2.5 21 6 15.5 13.5C12 18.5 9.5 23 8 28.5" />
                <path class="note__arrow-head" pathLength="1" d="M4 19L8 29L17.5 23.5" />
              </svg>
              <span class="note__text">check this out :)</span>
            </span></a>
        </p>
      </div>
    </header>

    <WorksStrip works={selectedWorks} start="spacefast" label="Selected works" />

    <Testimonials heading="Testimonials" quotes={["vercel", "sim", "agentmail", "feyn", "orchid"]} />

    <Pricing />

    <figure class="col pullquote">
      <blockquote>
        <p set:html={testimonials.agentphone.text} />
      </blockquote>
      <figcaption>Meet Modi, AgentPhone (YC P26)</figcaption>
    </figure>

    <Faq structuredData />

    <Closing />

    <Footer />
  </main>
</Layout>
