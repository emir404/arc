---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import Logo from "../components/Logo.astro";
import SpeedrunLogo from "../components/SpeedrunLogo.astro";
import WorksStrip from "../components/WorksStrip.astro";
import Testimonials from "../components/Testimonials.astro";
import Pricing from "../components/Pricing.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
import { bookCallUrl } from "../data/links";
import { selectedWorks } from "../data/works";
import { speedrunDiscount as discount } from "../data/plans";
import speedrunOg from "../assets/og-speedrun.png";
---

<Layout
  title="Arc Studio · All-in-one design studio for a16z speedrun founders"
  description={`Arc Studio is the all-in-one design studio for a16z speedrun founders, who get ${discount}% off. Worked with 10+ Y Combinator companies.`}
  og={{ image: speedrunOg, alt: `Arc Studio. All-in-one design studio. Worked with 10+ YC companies. speedrun founders get ${discount}% off.` }}
  lead
>
  <!-- As on the YC page, the logo heads the sidebar and leads back to the main page. -->
  <Sidebar
    sections={[
      { id: "top", label: "Arc Studio", logo: true, href: "/" },
      { id: "works", label: "Works" },
      { id: "testimonials", label: "Testimonials" },
      { id: "pricing", label: "Pricing" },
      { id: "contact", label: "Contact" },
    ]}
  />

  <!-- The class gives the page's highlighter strokes speedrun's colours in place of YC's orange. -->
  <main class="speedrun">
    <header class="col intro intro--lead" id="top">
      <Logo href="/" label="Arc, back to the main page" />

      <div class="lead">
        <h1 class="visually-hidden">Arc Studio for a16z speedrun founders</h1>
        <p><span class="hl">For a16z&nbsp;speedrun founders.</span> Worked with 10+ Y&nbsp;Combinator companies.</p>
        <!--
          The wordmark stands in for the word "speedrun", and screen readers get the word in its place.
          The rest of the line stays together, so on a phone it moves under the wordmark whole: the highlight
          never starts a line there, under the tail of the wordmark's p.
        -->
        <p><SpeedrunLogo /><span class="visually-hidden">speedrun</span> <span class="nowrap">companies get <mark class="marker">{discount}% off</mark>.</span></p>
        <p><a class="lead__link" href={bookCallUrl} target="_blank">Book a call</a></p>
      </div>
    </header>

    <WorksStrip works={selectedWorks} start="axiom" label="Selected works" from="speedrun" />

    <Testimonials heading="From founders" quotes={["vercel", "sim", "agentmail", "feyn", "orchid", "agentphone"]} />

    <Pricing heading="speedrun pricing" discount={discount} />

    <Closing heading="You got in. Now let’s speedrun to a world-class product." />

    <Footer />
  </main>
</Layout>
