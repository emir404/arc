---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import Logo from "../components/Logo.astro";
import SpeedrunLogo from "../components/SpeedrunLogo.astro";
import WorksStrip from "../components/WorksStrip.astro";
import Testimonials from "../components/Testimonials.astro";
import Pricing from "../components/Pricing.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
import Faq from "../components/Faq.astro";
import Actions from "../components/Actions.astro";
import { works, clients, clientName, hasPage, selectedWorks } from "../data/works";
import { capacity, dollars } from "../data/plans";
import { PRICES } from "../data/site";

// None of the studio's clients has been through speedrun yet, so the page's proof is neutral: the clients' names, and
// founders' quotes without their YC batches.
// TODO: swap to speedrun proof once we have an SR client.
const proof = {
  heading: "Founders we’ve shipped with",
  sub: "AI and dev-tool teams, from first brand to launch day.",
};
---

<Layout
  title="Arc Studio · All-in-one design studio for a16z speedrun founders"
  description={`Arc Studio is the all-in-one design studio for a16z speedrun founders. Speedrun price for Launch: ${dollars(PRICES.launchAccelerator)}.`}
  lead
>
  <!-- As on the YC page, the logo heads the sidebar and leads back to the main page. -->
  <Sidebar
    sections={[
      { id: "top", label: "Arc Studio", logo: true, href: "/" },
      { id: "works", label: "Works" },
      { id: "testimonials", label: "Testimonials" },
      { id: "pricing", label: "Pricing" },
      { id: "faq", label: "FAQ" },
      { id: "contact", label: "Contact" },
    ]}
  />

  <!-- The class gives the page's highlighter strokes speedrun's colours in place of YC's orange. -->
  <main class="speedrun">
    <header class="col intro intro--lead" id="top">
      <Logo href="/" label="Arc, back to the main page" />

      <div class="lead">
        <!-- The wordmark stands in for the word "speedrun", and screen readers get the word in its place. -->
        <h1><span class="hl"><SpeedrunLogo /><span class="visually-hidden">Speedrun</span> founders: launch-ready in a&nbsp;month.</span></h1>
        {/* The price stays with "price:", so the highlight never starts a line, where it would stick out past the column. */}
        <p>Brand, site, product screens, and launch video from one team. Speedrun <span class="nowrap">price: <mark class="marker">{dollars(PRICES.launchAccelerator)}</mark>.</span></p>
        <!-- As on the main page. The list stays on one line: a line break inside it would put a space before each comma. -->
        <p>
          Clients include {clients.map((key, i) => <>{i > 0 && ", "}{hasPage(works[key]) ? <a class="lead__link" href={`/work/${key}/`} target="_blank">{clientName(works[key])}</a> : <span class="lead__name">{clientName(works[key])}</span>}</>)} <span class="nowrap">&amp; more</span>
        </p>
        <Actions book="Book a Launch call" email="Or email us →" location="hero" offer="launch">
          <p class="cta__note">{capacity}</p>
        </Actions>
      </div>
    </header>

    <WorksStrip works={selectedWorks} start="axiom" label="Selected works" from="speedrun" />

    <Testimonials heading={proof.heading} sub={proof.sub} quotes={["vercel", "sim", "agentmail", "feyn", "orchid", "agentphone"]} batches={false} />

    <Pricing audience="speedrun" />

    <Faq audience="speedrun" />

    <Closing heading="You got in. Now let’s speedrun to a world-class product." />

    <Footer />
  </main>
</Layout>
