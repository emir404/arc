---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import Logo from "../components/Logo.astro";
import SpeedrunLogo from "../components/SpeedrunLogo.astro";
import WorksStrip from "../components/WorksStrip.astro";
import Testimonials from "../components/Testimonials.astro";
import Pricing from "../components/Pricing.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
import Actions from "../components/Actions.astro";
import { selectedWorks } from "../data/works";
import { dollars } from "../data/plans";
import { PRICES } from "../data/site";
---

<Layout
  title="Arc Studio · All-in-one design studio for a16z speedrun founders"
  description={`Arc Studio is the all-in-one design studio for a16z speedrun founders. Worked with 10+ Y Combinator companies. speedrun price for Launch: ${dollars(PRICES.launchAccelerator)}.`}
  lead
>
  <!-- As on the YC page, the logo heads the sidebar and leads back to the main page. -->
  <Sidebar
    sections={[
      { id: "top", label: "Arc Studio", logo: true, href: "/" },
      { id: "works", label: "Works" },
      { id: "testimonials", label: "Testimonials" },
      { id: "pricing", label: "Pricing" },
      { id: "contact", label: "Contact" },
    ]}
  />

  <!-- The class gives the page's highlighter strokes speedrun's colours in place of YC's orange. -->
  <main class="speedrun">
    <header class="col intro intro--lead" id="top">
      <Logo href="/" label="Arc, back to the main page" />

      <div class="lead">
        <!-- The wordmark stands in for the word "speedrun", and screen readers get the word in its place. -->
        <h1><span class="hl"><SpeedrunLogo /><span class="visually-hidden">Speedrun</span> founders: launch-ready in a&nbsp;month.</span></h1>
        <!-- As on the YC page, the price stays with "price:", so the highlight never starts a line. -->
        <p>Brand, site, product screens, and launch video from one team. Speedrun <span class="nowrap">price: <mark class="marker">{dollars(PRICES.launchAccelerator)}</mark>.</span></p>
        <p>Worked with 10+ Y&nbsp;Combinator companies.</p>
        <Actions book="Book a Launch call" email="Or email us →" location="hero" offer="launch" />
      </div>
    </header>

    <WorksStrip works={selectedWorks} start="axiom" label="Selected works" from="speedrun" />

    <Testimonials heading="From founders" quotes={["vercel", "sim", "agentmail", "feyn", "orchid", "agentphone"]} />

    <Pricing audience="speedrun" />

    <Closing heading="You got in. Now let’s speedrun to a world-class product." />

    <Footer />
  </main>
</Layout>
