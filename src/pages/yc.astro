---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import Logo from "../components/Logo.astro";
import YcLogo from "../components/YcLogo.astro";
import WorksStrip from "../components/WorksStrip.astro";
import Testimonials from "../components/Testimonials.astro";
import Pricing from "../components/Pricing.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
import Faq from "../components/Faq.astro";
import StickyBook from "../components/StickyBook.astro";
import Actions from "../components/Actions.astro";
import Until from "../components/Until.astro";
import { ycWorks } from "../data/works";
import { capacity, dollars } from "../data/plans";
import { PRICES, YC_BATCH_LINE } from "../data/site";
---

<Layout
  title="Arc for YC founders"
  description={`Launch before Demo Day. YC pricing: Launch ${dollars(PRICES.launchAccelerator)}, Partnership ${dollars(PRICES.partnershipAccelerator)}/month.`}
  lead
>
  <!-- As on the main page, the logo heads the sidebar; here it leads back to the main page. -->
  <Sidebar
    sections={[
      { id: "top", label: "Arc Studio", logo: true, href: "/" },
      { id: "works", label: "Works" },
      { id: "testimonials", label: "Testimonials" },
      { id: "pricing", label: "Pricing" },
      { id: "faq", label: "FAQ" },
      { id: "contact", label: "Contact" },
    ]}
  />

  <main>
    <header class="col intro intro--lead" id="top">
      <Logo href="/" label="Arc, back to the main page" />

      <div class="lead">
        <h1><span class="hl">Launch before Demo Day.</span></h1>
        <!--
          The price stays with its words, so the highlight never starts a line, where it would stick out past the column.
          The full stop is inside the highlight: after it, the highlight's padding would read as a space before it.
        -->
        <p>Brand, site, product screens, and launch video in one month. <span class="nowrap">YC price: <mark class="marker">{dollars(PRICES.launchAccelerator)}.</mark></span></p>
        <!-- The logo stands in for the "Y" of Y Combinator, and screen readers get a plain "Y" in its place. -->
        <p>We’ve worked with 10+ <span class="nowrap"><YcLogo /><span class="visually-hidden">Y</span> Combinator</span> companies.</p>
        <Actions book="Book a Launch call" email="Or email us →" location="hero" offer="launch">
          <Until date={YC_BATCH_LINE.until}><p class="cta__note">{YC_BATCH_LINE.text}</p></Until>
          <p class="cta__note">{capacity}</p>
        </Actions>
      </div>
    </header>

    <WorksStrip works={ycWorks} start="orchid" label="Selected works" from="yc" />

    <Testimonials heading="From YC founders" quotes={["sim", "agentmail", "feyn", "orchid", "agentphone"]} />

    <Pricing audience="yc" />

    <Faq audience="yc" />

    <!-- Names this batch's Demo Day, as YC_BATCH_LINE in site.ts does: change the two together. -->
    <Closing heading="Demo Day is December 2. Launch before it." />

    <Footer />

    <StickyBook />
  </main>
</Layout>
